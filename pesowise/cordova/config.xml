<?xml version='1.0' encoding='utf-8'?>
<widget id="com.example.pesowise" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>PesoWise</name>
    <description>Student allowance (baon) and expense tracker with receipt photos, budget alerts and fingerprint lock.</description>
    <author>PesoWise</author>
    <content src="index.html" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="Orientation" value="portrait" />
    <preference name="StatusBarBackgroundColor" value="#14532d" />
</widget>
